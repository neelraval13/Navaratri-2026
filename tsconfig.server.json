{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Node ESM semantics, matching how Vercel actually runs this code: the
       function is transpiled to ESM JavaScript and Node does NOT guess file
       extensions for relative imports. `bundler` resolution accepted
       extensionless specifiers that crashed the deployed function at module
       load, so the typecheck now enforces explicit `.js` specifiers. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Untrusted input crosses this boundary, so it is checked harder than the
       browser project rather than less. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api", "server", "src/shared"]
}
