{
  "name": "navaratri-2026-event-app",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b && pnpm typecheck:parity && pnpm typecheck:vercel-functions",
    "typecheck:client": "tsc -b tsconfig.app.json",
    "typecheck:server": "tsc -b tsconfig.server.json",
    "typecheck:parity": "tsc -p tsconfig.parity.json",
    "typecheck:vercel-functions": "node scripts/vercel-function-typecheck.mjs",
    "build": "pnpm typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:check": "node scripts/release-check.mjs",
    "verify:7b": "node scripts/verification/phase-7b.mjs",
    "verify:prior": "node scripts/verification/prior-phases.mjs",
    "verify": "pnpm verify:prior && pnpm verify:7b && pnpm verify:8a && pnpm verify:8b && pnpm verify:9a && pnpm verify:9b && pnpm verify:9ca && pnpm verify:9cb && pnpm verify:9cc1 && pnpm verify:parity && pnpm verify:9cc2a && pnpm verify:9cc2b && pnpm verify:9cc3a && pnpm verify:9cc3b && pnpm verify:config",
    "verify:8a": "node scripts/verification/phase-8a.mjs",
    "verify:8b": "node scripts/verification/phase-8b.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/db-check.mjs",
    "verify:9a": "node scripts/verification/phase-9a.mjs",
    "db:smoke": "node scripts/db-constraint-smoke.mjs",
    "verify:9b": "node scripts/verification/phase-9b.mjs",
    "verify:9ca": "node scripts/verification/phase-9ca.mjs",
    "verify:9cb": "node scripts/verification/phase-9cb.mjs",
    "verify:9cc1": "node scripts/verification/phase-9cc1.mjs",
    "verify:parity": "node scripts/verification/build-parity.mjs",
    "verify:9cc2a": "node scripts/verification/phase-9cc2a.mjs",
    "verify:9cc2b": "node scripts/verification/phase-9cc2b.mjs",
    "verify:9cc3a": "node scripts/verification/phase-9cc3a.mjs",
    "verify:9cc3b": "node scripts/verification/phase-9cc3b.mjs",
    "verify:config": "node scripts/verification/config-durability.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.3",
    "googleapis": "^180.0.0",
    "lucide-react": "^1.41.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
